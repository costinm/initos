#!/usr/bin/env bash

set -euo pipefail

usage() {
    cat >&2 <<'EOF'
Usage:
  initos-upgrade fetch [OWNER/REPO] [TAG] [DEST]
  initos-upgrade configure CONFIGURATION_NIX SYSTEM_PATH [--boot-next] [--reboot]
  initos-upgrade firmware-publish FIRMWARE_TREE BARE_REPO [REF]
  initos-upgrade firmware-fetch GIT_URL REV COMPOSEFS_IMAGE SLOT
  initos-upgrade install RELEASE_DIR DISK SLOT --write

fetch downloads and verifies the stable signed release assets.
configure records an already-rendered configuration and SYSTEM_PATH under
/z/c/initos/upgrades, activates that pre-built system, and can set a one-shot
boot into the alternate InitOS slot. --reboot requires --boot-next. It must run
as root. Closure construction and transfer belong on the build machine; use
scripts/configure-nixos from the InitOS source tree.
firmware-publish stores a firmware tree in a bare Git repository and prints the
commit ID. firmware-fetch incrementally fetches that commit, materializes
fs-verity-enabled composefs backing objects under /z/img/composefs, and verifies
none are missing.
install atomically extracts the signed slot payload into /z/img/SLOT, updates
its slot-local firmware payload, and writes its VFAT image to DISK partition
SLOT. SLOT must be 101 or 102; --write is mandatory.
EOF
    exit 2
}

firmware_tree_root() {
    local tree="${1}"
    if [ -d "${tree}/lib/firmware" ]; then
        printf '%s\n' "${tree}/lib/firmware"
    elif [ -d "${tree}" ]; then
        printf '%s\n' "${tree}"
    else
        echo "ERROR: firmware tree not found: ${tree}" >&2
        return 1
    fi
}

image_has_signature() {
    local image="${1:?image path is required}"
    [ -f "${image}.sig" ] || compgen -G "${image}.*.db.sig" >/dev/null
}

configure_nixos() {
    local source="${1:?configuration.nix path is required}"
    local system_path="${2:?pre-built NixOS system path is required}"
    shift 2
    local boot_next=0 reboot_after=0
    local state_root=/z/c/initos upgrades_root record stamp system_name
    local current_boot current_slot next_boot next_slot
    local -a old_records

    while [ "$#" -gt 0 ]; do
        case "${1}" in
            --boot-next) boot_next=1 ;;
            --reboot) reboot_after=1 ;;
            *) echo "ERROR: unknown configure option: ${1}" >&2; exit 2 ;;
        esac
        shift
    done
    if [ "${reboot_after}" -eq 1 ] && [ "${boot_next}" -ne 1 ]; then
        echo "ERROR: --reboot requires --boot-next" >&2
        exit 2
    fi
    upgrades_root="${state_root}/upgrades"

    if [ "$(id -u)" -ne 0 ]; then
        echo "ERROR: configure must run as root" >&2
        exit 1
    fi
    if [ ! -f "${source}" ]; then
        echo "ERROR: NixOS configuration not found: ${source}" >&2
        exit 1
    fi
    if ! command -v nix-env >/dev/null 2>&1; then
        echo "ERROR: nix-env is not available" >&2
        exit 1
    fi
    if [ "${boot_next}" -eq 1 ] && ! command -v efibootmgr >/dev/null 2>&1; then
        echo "ERROR: efibootmgr is not available" >&2
        exit 1
    fi
    case "${system_path}" in
        /nix/store/*) ;;
        *) echo "ERROR: invalid NixOS system path: ${system_path}" >&2; exit 1 ;;
    esac
    if [ ! -x "${system_path}/bin/switch-to-configuration" ]; then
        echo "ERROR: pre-built NixOS system is not present in the local store: ${system_path}" >&2
        exit 1
    fi
    if ! nix-store --verify-path "${system_path}"; then
        echo "ERROR: pre-built NixOS system failed store verification: ${system_path}" >&2
        exit 1
    fi

    if grep -q '\$INITOS_HOSTNAME' "${source}"; then
        echo "ERROR: configuration was not rendered on the build machine: ${source}" >&2
        exit 1
    fi

    install -d -m 0755 "${upgrades_root}"
    stamp=$(date -u +%Y%m%dT%H%M%SZ)
    system_name=$(printf '%s' "$(basename "${system_path}")" | tr -c 'A-Za-z0-9._-' '_')
    record="${upgrades_root}/${stamp}-${system_name}"
    install -d -m 0755 "${record}"
    install -m 0644 "${source}" "${record}/configuration.nix"
    if [ -f /etc/nixos/configuration.nix ]; then
        install -m 0644 /etc/nixos/configuration.nix "${record}/configuration.before.nix"
    fi
    printf '%s\n' "${system_path}" > "${record}/system-path"
    printf 'running\n' > "${record}/status"
    ln -sfn "upgrades/$(basename "${record}")" "${state_root}/latest-upgrade"

    exec > >(tee -a "${record}/activation.log") 2>&1
    trap 'rc=$?; if [ "${rc}" -eq 0 ]; then printf "complete\n" > "'"${record}"'/status"; else printf "failed exit=%s\n" "${rc}" > "'"${record}"'/status"; fi' EXIT

    if command -v efibootmgr >/dev/null 2>&1; then
        efibootmgr > "${record}/efibootmgr.before" 2>&1 || true
        current_boot=$(sed -n 's/^BootCurrent: \([[:xdigit:]]\{4\}\)$/\1/p' "${record}/efibootmgr.before" | head -n 1)
        if [ -n "${current_boot}" ]; then
            current_slot=$(sed -n "/^Boot${current_boot}[* ]/s/.*HD(\([0-9][0-9]*\),.*/\1/p" "${record}/efibootmgr.before" | head -n 1)
        fi
        if [ -z "${current_slot:-}" ] && [ -f "${state_root}/current-slot" ]; then
            current_slot=$(cat "${state_root}/current-slot")
            printf 'saved-state\n' > "${record}/current-slot-source"
        elif [ -n "${current_slot:-}" ]; then
            printf 'efibootmgr\n' > "${record}/current-slot-source"
        fi
        if [ -n "${current_slot:-}" ]; then
            printf '%s\n' "${current_slot}" > "${record}/current-slot"
            printf '%s\n' "${current_slot}" > "${state_root}/current-slot"
        fi
    fi

    echo "Upgrade record: ${record}"
    nix-env --profile /nix/var/nix/profiles/system --set "${system_path}"
    "${system_path}/bin/switch-to-configuration" switch

    if [ "${boot_next}" -eq 1 ]; then
        case "${current_slot:-}" in
            101) next_slot=102 ;;
            102) next_slot=101 ;;
            *) echo "ERROR: current boot entry is not InitOS slot 101 or 102" >&2; exit 1 ;;
        esac
        mapfile -t old_records < <(sed -n "s/^Boot\([[:xdigit:]]\{4\}\)[* ] .*HD(${next_slot},.*/\1/p" "${record}/efibootmgr.before")
        if [ "${#old_records[@]}" -ne 1 ]; then
            echo "ERROR: expected exactly one EFI boot entry for alternate slot ${next_slot}, found ${#old_records[@]}" >&2
            exit 1
        fi
        next_boot="${old_records[0]}"
        efibootmgr --bootnext "${next_boot}"
        efibootmgr > "${record}/efibootmgr.after" 2>&1
        printf '%s\n' "${next_slot}" > "${record}/next-slot"
        printf '%s\n' "${next_boot}" > "${record}/next-boot-entry"
        echo "Next boot is temporarily set to InitOS slot ${next_slot} (Boot${next_boot})"
    fi

    # Keep every record from the last three weeks and always retain the ten
    # newest records, even if upgrades have been infrequent.
    mapfile -d '' -t old_records < <(find "${upgrades_root}" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\0' | sort -zrn)
    if [ "${#old_records[@]}" -gt 10 ]; then
        for old_record in "${old_records[@]:10}"; do
            old_record=${old_record#* }
            case "${old_record}" in "${upgrades_root}"/*) ;; *) continue ;; esac
            if [ -d "${old_record}" ] && [ -n "$(find "${old_record}" -maxdepth 0 -mtime +21 -print -quit)" ]; then
                rm -rf -- "${old_record}"
            fi
        done
    fi

    if [ "${reboot_after}" -eq 1 ]; then
        printf 'rebooting\n' > "${record}/status"
        sync
        systemctl reboot
    fi
}

firmware_publish() {
    local tree="${1:?firmware tree is required}"
    local repo="${2:?bare Git repository path is required}"
    local ref="${3:-refs/heads/main}"
    local tree_root tree_id commit_id

    tree_root=$(firmware_tree_root "${tree}")
    case "${ref}" in
        refs/heads/*) ;;
        *) echo "ERROR: publish ref must start with refs/heads/: ${ref}" >&2; exit 1 ;;
    esac
    if [ ! -d "${repo}" ]; then
        install -d -m 0755 "$(dirname "${repo}")"
        git init --bare --initial-branch=main "${repo}" >/dev/null
    fi
    if [ ! -f "${repo}/HEAD" ]; then
        echo "ERROR: not a bare Git repository: ${repo}" >&2
        exit 1
    fi
    # Firmware blobs are binary inputs even when a filename looks textual.
    # Never apply a caller's line-ending conversion policy.
    GIT_DIR="${repo}" git config core.autocrlf false

    GIT_DIR="${repo}" GIT_WORK_TREE="${tree_root}" git read-tree --empty
    GIT_DIR="${repo}" GIT_WORK_TREE="${tree_root}" git add -A
    tree_id=$(GIT_DIR="${repo}" git write-tree)
    commit_id=$(printf 'InitOS firmware tree %s\n' "${tree_id}" | \
        GIT_AUTHOR_NAME=InitOS GIT_AUTHOR_EMAIL=initos@localhost \
        GIT_COMMITTER_NAME=InitOS GIT_COMMITTER_EMAIL=initos@localhost \
        GIT_AUTHOR_DATE='@1 +0000' GIT_COMMITTER_DATE='@1 +0000' \
        GIT_DIR="${repo}" git commit-tree "${tree_id}")
    GIT_DIR="${repo}" git update-ref "${ref}" "${commit_id}"
    GIT_DIR="${repo}" git symbolic-ref HEAD "${ref}"
    : > "${repo}/git-daemon-export-ok"
    chmod -R a+rX "${repo}"
    printf '%s\n' "${commit_id}"
}

firmware_fetch() {
    local git_url="${1:?firmware Git URL is required}"
    local revision="${2:?firmware Git revision is required}"
    local composefs_image="${3:?composefs image is required}"
    local slot="${4:?slot is required}"
    local destination shared_root objects
    local repo source_repo record mode path object_id object_type
    local stage object_file digest object_dir object_name tree_path link_target

    case "${slot}" in
        101|102) ;;
        *) echo "ERROR: SLOT must be 101 or 102" >&2; exit 1 ;;
    esac
    destination="/z/img/${slot}/firmware-objects"
    shared_root="/z/img/composefs"
    objects="${shared_root}/objects"
    if [[ ! "${revision}" =~ ^[0-9a-f]{40}$ ]] && [[ ! "${revision}" =~ ^[0-9a-f]{64}$ ]]; then
        echo "ERROR: firmware revision must be a 40- or 64-character Git commit ID" >&2
        exit 1
    fi
    if [ ! -f "${composefs_image}" ]; then
        echo "ERROR: composefs image not found: ${composefs_image}" >&2
        exit 1
    fi

    install -d -m 0755 "${destination}" "${destination}/revisions" \
        "${destination}/trees" "${shared_root}" "${objects}" /z/img/git
    # New installations use one append-only CAS shared by both boot slots.
    # Retain an existing slot-local objects directory for compatibility; boot
    # prefers the shared CAS and falls back to the legacy directory.
    if [ ! -e "${destination}/objects" ]; then
        ln -s ../../composefs/objects "${destination}/objects"
    fi
    if [ -d "${git_url}/objects" ]; then
        source_repo="${git_url}"
    else
        repo="/z/img/git/initos-firmware.git"
        if [ ! -f "${repo}/HEAD" ]; then
            git init --bare --initial-branch=main "${repo}" >/dev/null
        fi
        git --git-dir="${repo}" fetch --no-tags "${git_url}" "${revision}"
        source_repo="${repo}"
    fi
    git --git-dir="${source_repo}" rev-parse --verify "${revision}^{commit}" >/dev/null

    stage=$(mktemp -d "${destination}/.objects.XXXXXX")
    # Expand the private mktemp path now: function-local variables no longer
    # exist when an EXIT trap runs after an error.
    trap "rm -rf -- '${stage}'" EXIT
    mkdir -p "${stage}/tree"
    git --git-dir="${source_repo}" ls-tree -r -z "${revision}" | \
      while IFS= read -r -d "" record; do
        mode=${record%% *}
        object_type=${record#* }
        object_type=${object_type%% *}
        [ "${object_type}" = blob ] || continue
        object_id=${record#* blob }
        object_id=${object_id%%$'\t'*}
        path=${record#*$'\t'}
        case "/${path}/" in
            *'/../'*|*'/./'*) echo "ERROR: unsafe Git path: ${path}" >&2; exit 1 ;;
        esac
        tree_path="${stage}/tree/${path}"
        mkdir -p "$(dirname "${tree_path}")"
        if [ "${mode}" = 120000 ]; then
            link_target=$(git --git-dir="${source_repo}" cat-file blob "${object_id}")
            ln -s "${link_target}" "${tree_path}"
            continue
        fi
        object_file=$(mktemp "${stage}/object.XXXXXX")
        git --git-dir="${source_repo}" cat-file blob "${object_id}" > "${object_file}"
        digest=$(fsverity digest "${object_file}" | awk '{print $1}' | sed 's/^sha256://')
        object_dir="${objects}/$(printf '%s' "${digest}" | cut -c1-2)"
        object_name=$(printf '%s' "${digest}" | cut -c3-)
        mkdir -p "${object_dir}"
        if [ ! -e "${object_dir}/${object_name}" ]; then
            fsverity enable "${object_file}" >/dev/null
            chmod 0444 "${object_file}"
            mv "${object_file}" "${object_dir}/${object_name}"
        else
            rm -f "${object_file}"
        fi
        ln -s "${object_dir}/${object_name}" "${tree_path}"
    done
    composefs-info --basedir="${objects}" missing-objects "${composefs_image}"
    if [ -e "${destination}/trees/${revision}" ]; then
        rm -rf "${stage}/tree"
    else
        mv "${stage}/tree" "${destination}/trees/${revision}"
    fi
    printf '%s\n' "${git_url}" > "${destination}/revisions/${revision}.source"
    ln -sfn "trees/${revision}" "${destination}/current"
    rm -rf "${stage}"
    trap - EXIT
    printf '%s\n' "${objects}"
}

partition_device() {
    local disk="${1}"
    local slot="${2}"
    case "${disk}" in
        *[0-9]) printf '%sp%s\n' "${disk}" "${slot}" ;;
        *) printf '%s%s\n' "${disk}" "${slot}" ;;
    esac
}

fetch_release() {
    local repo="${1:-costinm/initos}"
    local tag="${2:-signed-rolling}"
    local dest="${3:-.}"
    local base="https://github.com/${repo}/releases/download/${tag}"
    local file

    install -d -m 0755 "${dest}"
    for file in initos-signed-slot.tar.gz SHA256SUMS; do
        curl -fL --retry 3 --proto '=https' --tlsv1.2 \
            -o "${dest}/${file}" "${base}/${file}"
    done
    (cd "${dest}" && sha256sum -c SHA256SUMS)
}

install_slot() {
    local release_dir="${1:?release directory is required}"
    local disk="${2:?whole-disk device is required}"
    local slot="${3:?slot is required}"
    local confirm="${4:-}"
    local partition slot_archive sums slot_stage previous_slot

    release_dir=$(cd "${release_dir}" && pwd)
    slot_archive="${release_dir}/initos-signed-slot.tar.gz"
    sums="${release_dir}/SHA256SUMS"

    case "${slot}" in
        101|102) ;;
        *) echo "ERROR: SLOT must be 101 or 102" >&2; exit 1 ;;
    esac
    if [ "${confirm}" != --write ]; then
        echo "ERROR: refusing to write a boot partition without --write" >&2
        exit 1
    fi
    if [ ! -b "${disk}" ]; then
        echo "ERROR: not a block device: ${disk}" >&2
        exit 1
    fi

    partition=$(partition_device "${disk}" "${slot}")
    if [ ! -b "${partition}" ]; then
        echo "ERROR: slot partition is not a block device: ${partition}" >&2
        exit 1
    fi
    if [ ! -f "${slot_archive}" ] || [ ! -f "${sums}" ]; then
        echo "ERROR: release directory must contain the signed slot archive and SHA256SUMS" >&2
        exit 1
    fi
    (cd "${release_dir}" && sha256sum -c SHA256SUMS)

    install -d -m 0755 /z/img
    slot_stage=$(mktemp -d /z/img/.initos-slot.XXXXXX)
    trap "rm -rf -- '${slot_stage}'" EXIT
    tar -xzf "${slot_archive}" -C "${slot_stage}" --no-same-owner --no-same-permissions
    if [ ! -f "${slot_stage}/boot-initos-signed.vfat" ] || \
       [ ! -f "${slot_stage}/initos.erofs" ] || \
       [ ! -f "${slot_stage}/firmware-light.composefs" ] || \
       [ ! -f "${slot_stage}/firmware-light.basedir" ]; then
        echo "ERROR: signed release payload is incomplete" >&2
        exit 1
    fi
    if ! image_has_signature "${slot_stage}/firmware-light.composefs"; then
        echo "ERROR: firmware payload contains an unsigned image" >&2
        exit 1
    fi
    if [ ! -d /z/img/composefs/objects ]; then
        echo "ERROR: shared composefs object store is missing; import OCI or fetch Git firmware first" >&2
        exit 1
    fi
    composefs-info --basedir=/z/img/composefs/objects missing-objects \
        "${slot_stage}/firmware-light.composefs"

    previous_slot="/z/img/${slot}.previous"
    if [ -e "${previous_slot}" ]; then
        echo "ERROR: previous interrupted upgrade backup exists: ${previous_slot}" >&2
        exit 1
    fi
    if [ -e "/z/img/${slot}" ]; then
        mv -T "/z/img/${slot}" "${previous_slot}"
    fi
    mv -T "${slot_stage}" "/z/img/${slot}"
    sync

    echo "Writing /z/img/${slot}/boot-initos-signed.vfat to ${partition}"
    dd if="/z/img/${slot}/boot-initos-signed.vfat" of="${partition}" \
        bs=4M conv=fsync status=progress
    sync
    rm -rf "${previous_slot}"
    trap - EXIT
    echo "Installed signed slot ${slot}, including firmware, in /z/img/${slot}"
}

main() {
    case "${1:-}" in
        fetch) shift; fetch_release "$@" ;;
        configure) shift; [ "$#" -ge 2 ] && [ "$#" -le 4 ] || usage; configure_nixos "$@" ;;
        firmware-publish) shift; [ "$#" -ge 2 ] && [ "$#" -le 3 ] || usage; firmware_publish "$@" ;;
        firmware-fetch) shift; [ "$#" -eq 4 ] || usage; firmware_fetch "$@" ;;
        install) shift; [ "$#" -eq 4 ] || usage; install_slot "$@" ;;
        *) usage ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
